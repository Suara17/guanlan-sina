# Local development template for worktree bootstrap.
# Copy to .env when running the app directly on the host machine.

PROJECT_NAME=天工·弈控
ENVIRONMENT=local
STACK_NAME=guanlan-sina
DOMAIN=localhost.tiangolo.com

DOCKER_IMAGE_BACKEND=guanlan-sina-backend
DOCKER_IMAGE_FRONTEND=guanlan-sina-frontend
TAG=latest

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
ACCESS_TOKEN_EXPIRE_MINUTES=11520

FRONTEND_HOST=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

REDIS_URL=redis://localhost:6379/0

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j
NEO4J_BROWSER_URL=http://localhost:7474

SENTRY_DSN=

# Docker 运行时知识问答缓存目录
DOCKER_CHROMA_PERSIST_DIR=/data/chroma
DOCKER_HF_HOME=/data/hf
DOCKER_TRANSFORMERS_CACHE=/data/hf/transformers
DOCKER_SENTENCE_TRANSFORMERS_HOME=/data/hf/sentence-transformers
